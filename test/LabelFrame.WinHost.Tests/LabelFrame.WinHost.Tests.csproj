<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100</TargetFramework>
    <RootNamespace>LabelFrame.WinHost.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- WinHost 的 WebView2 包 buildTransitive 引入 Wpf 变体（未用 WPF），与框架 WindowsBase 解析产生 MSB3277，属良性冲突 -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <!-- 假名 / 韩文样本测试需运行时跳过（存在性探测 + 缺失跳过，不假绿），
         xunit v2 需官方 SkippableFact 扩展实现运行时 Skip（仅测试依赖，不进发布闭包）。 -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- 毒丸引用清单（自插件工程迁移而来）：引用 LabelFrame.TransportPlugin.Zebra 后其 Zebra SDK 传递的
       MAUI / WinUI 链需要在消费侧同样显式排除——否则 WindowsAppSDK 的版本特定 RID 图触发 NETSDK1206 告警。 -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.2" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.Views" Version="3.119.2" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.Views.Maui.Core" Version="3.119.2" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.Views.WinUI" Version="3.119.2" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.WinUI" Version="3.119.2" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Controls.Core" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Controls.Xaml" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Core" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Graphics.Win2D.WinUI.Desktop" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Resizetizer" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Controls.Build.Tasks" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.2.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240627000" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LabelFrame.WinHost\LabelFrame.WinHost.csproj" />
    <ProjectReference Include="..\..\src\LabelFrame.Rendering\LabelFrame.Rendering.csproj" />
    <ProjectReference Include="..\LabelFrame.TransportPlugin.Sample\LabelFrame.TransportPlugin.Sample.csproj" />
    <!-- Zebra 官方插件工程：迁移后的传输行为测试与官方包安装 / 版本比较用例的程序集来源 -->
    <ProjectReference Include="..\..\src\LabelFrame.TransportPlugin.Zebra\LabelFrame.TransportPlugin.Zebra.csproj" />
    <!-- TSPL 官方插件工程（迭代 143，决策 #195）：编译器 / 传输 / 图片编码测试的程序集来源 -->
    <ProjectReference Include="..\..\src\LabelFrame.TransportPlugin.Tspl\LabelFrame.TransportPlugin.Tspl.csproj" />
  </ItemGroup>

</Project>