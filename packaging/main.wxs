<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="LabelFrame Client" Manufacturer="LabelFrame" Version="$(var.Version)"
           UpgradeCode="EE3F2357-56CE-4C0F-AEC1-4C04B6E6BCDA" Codepage="65001">
    <SummaryInformation Description="LabelFrame 打印客户端：托管完整界面（模板设计 / 数据与打印 / 连接配置 / 日志 / 作业历史）并连接本机打印机打印（安装于 Program Files\LabelFrame\Client）" />
    <MajorUpgrade DowngradeErrorMessage="已安装的 LabelFrame 版本更新，无法降级。" />
    <Property Id="LABELFRAME_MIN_SERVER_VERSION" Value="1.0.0" />
    <Property Id="LABELFRAME_MAX_SERVER_VERSION" Value="2.0.0" />
    <Property Id="LABELFRAME_RUNTIME_MAJOR" Value="10" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- 安装向导 UI（欢迎 / 许可 / 目录 / 进度 / 完成）+ 品牌资产（assets/ 静态文件，源出 assets/brand/ 母版库）+ 控制面板元数据 -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.AssetsDir)/installer-dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.AssetsDir)/installer-banner.bmp" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <!-- 开机自启（安装选项页勾选）：默认开启，控制 HKLM Run 键组件 -->
    <Property Id="AUTO_START" Value="1" />
    <!-- 完成页可选复选框（ExitDialog 自带控件）：文本经属性格式化，默认勾选 -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="立即打开 LabelFrame" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Icon Id="LabelframeAppIco" SourceFile="$(var.AssetsDir)/labelframe.ico" />
    <Property Id="ARPPRODUCTICON" Value="LabelframeAppIco" />
    <Property Id="ARPHELPLINK" Value="https://github.com/marci-labs/LabelFrame" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/marci-labs/LabelFrame/releases" />


    <!-- 检测 ASP.NET Core Runtime：改用 .NET 官方 NetCoreCheck 自检（属性值 0=满足；12289=未安装；12290=版本不足；13=平台不兼容） -->
    <!-- RuntimeType = aspnet：WinHost 为 Microsoft.NET.Sdk.Web（隐式 FrameworkReference
         Microsoft.AspNetCore.App），实际框架需求是 AspNetCore 而非仅 Desktop——两者互不包含，只装 Desktop Runtime 的机器
         必须在检测阶段拦截，而非装完客户端进程起不来（.NET Runtime 1023）。
         注：WinHost 双框架需求（WinForms 的 WindowsDesktop + Web 托管的 AspNetCore）中 Desktop 腿由引导链 runtime-desktop 补装承载，
         NetCoreCheck 单检测单 RuntimeType，静默直装场景以 AspNetCore 口径为拦截锚点。
         WiX netfx 扩展的 RuntimeType 合法枚举为 aspnet / desktop / core（构建实测 WIX0021），aspnet 对应 ASP.NET Core Runtime。 -->
    <!-- 之前的注册表搜索读不到运行时，因为版本号是命名值而非默认值，这里不再依赖注册表结构 -->
    <netfx:DotNetCompatibilityCheck Id="DotNet10RuntimeCheck"
                                    Property="DOTNET10_PRESENT"
                                    Platform="x64"
                                    RuntimeType="aspnet"
                                    Version="10.0.0"
                                    RollForward="latestMajor" />
    <Launch Condition="DOTNET10_PRESENT = &quot;0&quot; OR UILevel = 5 OR REMOVE"
      Message="本机未检测到 ASP.NET Core Runtime，请先安装后重新运行安装程序。下载：https://dotnet.microsoft.com/download/dotnet/10.0" />

    <!-- 检测 WebView2 Evergreen 运行时：界面窗口（WebView2 嵌入）依赖；
         注册表 EdgeUpdate Clients 的 WebView2 产品键（per-machine 走 WOW6432Node 视图 / per-user HKCU），
         键随运行时安装即写入 → 向导内「重新检测」装完即可继续（无需重启安装程序）。
         全 UI 缺失时由 WebView2MissingDlg 引导（下方）；静默 / 基础 UI 由 LaunchCondition 拦截。 -->
    <Property Id="WEBVIEW2_HKLM">
      <RegistrySearch Id="WebView2PerMachine" Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
    </Property>
    <Property Id="WEBVIEW2_HKCU">
      <RegistrySearch Id="WebView2PerUser" Root="HKCU" Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
    </Property>
    <!-- 「重新检测」实现：外部 VBScript 立即时动作重读注册表（WiX v7 移除内联脚本，须 ScriptSourceFile）；
         VBScript 为已弃用组件（WIX1163）：仅用于本按钮的重新检测，退出按钮不依赖它 -->
    <CustomAction Id="RecheckWebView2" Script="vbscript" ScriptSourceFile="$(var.PackagingDir)/recheck-webview2.vbs" />
    <Launch Condition="WEBVIEW2_HKLM OR WEBVIEW2_HKCU OR UILevel = 5 OR REMOVE"
      Message="本机未检测到 Microsoft Edge WebView2 运行时（LabelFrame 界面窗口依赖），请先安装后重新运行安装程序。下载：https://go.microsoft.com/fwlink/p/?LinkId=2124703" />

    <!-- 运行时缺失对话框：可点击官方下载链接（MSI Hyperlink 控件） -->
    <UI Id="RuntimeCheckUI">
      <Dialog Id="RuntimeMissingDlg" X="50" Y="50" Width="370" Height="180"
              Title="LabelFrame 安装 - 缺少 ASP.NET Core Runtime" NoMinimize="yes">
        <Control Id="TitleText" Type="Text" X="15" Y="15" Width="340" Height="30"
                 Text="本机未检测到 ASP.NET Core 10 Runtime，请先安装后再运行本安装程序。" />
        <Control Id="HintText" Type="Text" X="15" Y="50" Width="340" Height="20"
                 Text="点击下方链接打开微软官方下载页：" />
        <Control Id="RuntimeLink" Type="Hyperlink" X="15" Y="75" Width="340" Height="25"
                 Text="&lt;a href=&quot;https://dotnet.microsoft.com/download/dotnet/10.0&quot;&gt;https://dotnet.microsoft.com/download/dotnet/10.0&lt;/a&gt;" />
        <Control Id="ExitButton" Type="PushButton" X="280" Y="140" Width="75" Height="25"
                 Text="退出" Default="yes" Cancel="yes">
          <Publish Event="EndDialog" Value="Exit" Condition="1" />
        </Control>
      </Dialog>
      <!-- WebView2 运行时缺失（全 UI）：官方下载链接 + 重新检测（注册表键随运行时安装即写入，装完点重新检测即可继续，无需重启安装程序） -->
      <Dialog Id="WebView2MissingDlg" X="50" Y="50" Width="370" Height="200"
              Title="LabelFrame 安装 - 缺少 WebView2 运行时" NoMinimize="yes">
        <Control Id="TitleText" Type="Text" X="15" Y="15" Width="340" Height="40"
                 Text="本机未检测到 Microsoft Edge WebView2 运行时（LabelFrame 界面窗口需要），请先安装。" />
        <Control Id="HintText" Type="Text" X="15" Y="62" Width="340" Height="20"
                 Text="点击下方链接打开微软官方下载页（Evergreen 版本）：" />
        <Control Id="WebView2Link" Type="Hyperlink" X="15" Y="87" Width="340" Height="25"
                 Text="&lt;a href=&quot;https://go.microsoft.com/fwlink/p/?LinkId=2124703&quot;&gt;https://go.microsoft.com/fwlink/p/?LinkId=2124703&lt;/a&gt;" />
        <Control Id="HintText2" Type="Text" X="15" Y="118" Width="340" Height="20"
                 Text="安装完成后点击「重新检测」继续本安装程序。" />
        <Control Id="RetryButton" Type="PushButton" X="177" Y="160" Width="90" Height="25" Text="重新检测">
          <Publish Event="DoAction" Value="RecheckWebView2" />
          <Publish Event="EndDialog" Value="Return" Condition="WEBVIEW2_OK = &quot;1&quot;" />
        </Control>
        <Control Id="ExitButton" Type="PushButton" X="280" Y="160" Width="75" Height="25"
                 Text="退出" Default="yes" Cancel="yes">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <!-- 卸载时询问是否清除用户数据（默认不勾选；仅手动卸载，不适用于升级） -->
      <Dialog Id="ClearDataDlg" X="50" Y="50" Width="370" Height="170"
              Title="LabelFrame Client 卸载" NoMinimize="yes">
        <Control Id="TitleText" Type="Text" X="15" Y="15" Width="340" Height="25" Text="卸载 LabelFrame Client。" />
        <Control Id="HintText" Type="Text" X="15" Y="45" Width="340" Height="30"
                 Text="是否同时清除本程序产生的用户数据（模板 / 作业 / 日志 / 连接与打印配置）？" />
        <Control Id="ClearDataCheck" Type="CheckBox" X="15" Y="85" Width="340" Height="18"
                 Property="CLEAR_USER_DATA" CheckBoxValue="1" Text="清除用户数据" />
        <Control Id="CancelButton" Type="PushButton" X="200" Y="135" Width="75" Height="25"
                 Text="取消" Cancel="yes">
          <Publish Event="EndDialog" Value="Exit" Condition="1" />
        </Control>
        <Control Id="NextButton" Type="PushButton" X="280" Y="135" Width="75" Height="25"
                 Text="继续" Default="yes">
          <Publish Event="EndDialog" Value="Return" Condition="1" />
        </Control>
      </Dialog>
      <!-- 安装选项页：目录页之后、确认安装页之前 -->
      <Dialog Id="OptionsDlg" Width="370" Height="270" Title="[ProductName] 安装">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="yes" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" TabSkip="yes"
                 Text="{\WixUI_Font_Title}安装选项" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="AutoStartCheck" Type="CheckBox" X="20" Y="80" Width="300" Height="17"
                 Property="AUTO_START" CheckBoxValue="1" Text="开机自动启动 LabelFrame" />
        <Control Id="AutoStartHint" Type="Text" X="20" Y="105" Width="320" Height="40"
                 Text="开机自启以托盘方式常驻运行，不自动打开界面窗口；可随时从托盘图标打开界面或退出。" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="上一步(&amp;B)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="下一步(&amp;N)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="取消">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <!-- 向导链路改道：目录页 Next 先进选项页；确认页 Back（仅全新安装）回选项页。
           ControlEvent 重复发布时后执行者生效，Order 越大越后执行。 -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="OptionsDlg" Order="10" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="OptionsDlg" Order="10"
               Condition="NOT Installed AND NOT REMOVE" />
      <!-- 向导完成页启动：对 UI 扩展库的 ExitDialog 追加控件事件（勾选 + 全新安装才启动） -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchClientOnExit"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = &quot;1&quot; AND NOT Installed" />
    </UI>
    <InstallUISequence>
      <Show Dialog="RuntimeMissingDlg" Sequence="1150"
            Condition="NOT DOTNET10_PRESENT = &quot;0&quot; AND NOT REMOVE" />
      <!-- WebView2 检测在 .NET 检测之后（两者都缺时先引导 .NET）；全 UI 才显示，静默 / 基础 UI 由 LaunchCondition 拦截 -->
      <Show Dialog="WebView2MissingDlg" Sequence="1160"
            Condition="NOT WEBVIEW2_HKLM AND NOT WEBVIEW2_HKCU AND DOTNET10_PRESENT = &quot;0&quot; AND NOT REMOVE" />
      <Show Dialog="ClearDataDlg" Sequence="1290"
            Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallUISequence>

    <!-- 安装目录：Program Files\LabelFrame（64 位） -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="LABELFRAMEROOT" Name="LabelFrame">
      <Directory Id="INSTALLFOLDER" Name="Client">
      <!-- 官方插件附带包：随 MSI 携带 Zebra / TSPL 外置插件包，供存量升级自动安装
           （OfficialPluginMigration 启动检测已用官方插件配置 → 从本目录自动装外置插件）。
           build-msi.ps1 检测到 artifacts 下的 .lfplugin 时传入 -d ZebraPluginPackage / -d TsplPluginPackage
           才编译对应块（本地无产物可跳过）。 -->
      <?ifdef ZebraPluginPackage?>
      <Directory Id="PluginPackagesDir" Name="plugin-packages">
        <Component Id="ZebraPluginPackageFile" Guid="7C4E1B2A-9D53-4F86-B8A1-3E2D5C7F9A04">
          <File Id="ZebraPluginPackageFile" Source="$(var.ZebraPluginPackage)" KeyPath="yes" />
        </Component>
      </Directory>
      <?endif?>
      <?ifdef TsplPluginPackage?>
      <Directory Id="TsplPluginPackagesDir" Name="plugin-packages">
        <Component Id="TsplPluginPackageFile" Guid="A2B8D4F6-3C71-4E9A-8B05-D7E1F3A9C624">
          <File Id="TsplPluginPackageFile" Source="$(var.TsplPluginPackage)" KeyPath="yes" />
        </Component>
      </Directory>
      <?endif?>
      <!-- 用户配置 appsettings.json：独立组件、GUID 固定；NeverOverwrite 升级/修复不覆盖，
           Permanent 卸载不删除，保留用户数据（新装仍写入默认配置） -->
      <Component Id="AppSettingsFile" Guid="B0E5FE56-15B9-4373-9F93-F0C5380D0060" NeverOverwrite="yes" Permanent="yes">
        <File Id="AppSettingsFile" Source="$(var.PublishDir)/appsettings.json" KeyPath="yes" />
      </Component>
    </Directory>
    </Directory>
    </StandardDirectory>

    <!-- 开机自启注册表（HKLM Run 键）：由隐藏子 Feature 的 Level 条件控制——安装选项页未勾选（AUTO_START 空）时 Level=0 不安装 -->
    <Component Id="AutoStartRunKey" Guid="3F8A9C71-6B2D-4E45-9A10-58C6E2D7B013">
      <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="LabelFrame" Type="string" Value="&quot;[#WinHostExe]&quot; --autostart" KeyPath="yes" />
    </Component>

    <!-- 开始菜单 -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="LabelFrame">
        <Component Id="StartMenuShortcut">
          <Shortcut Id="StartMenuShortcut" Name="LabelFrame Client"
                    Description="打开 LabelFrame 界面编辑与打印标签"
                    Target="[#WinHostExe]"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="ApplicationProgramsRemove" Directory="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\LabelFrame" Name="startmenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- 桌面快捷方式 -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut">
        <Shortcut Id="DesktopShortcut" Name="LabelFrame Client"
                  Description="打开 LabelFrame 界面编辑与打印标签"
                  Target="[#WinHostExe]"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="DesktopRemove" Directory="DesktopFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\LabelFrame" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="LabelFrame" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="WebFiles" />
      <ComponentRef Id="AppSettingsFile" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <?ifdef ZebraPluginPackage?>
      <ComponentRef Id="ZebraPluginPackageFile" />
      <?endif?>
      <?ifdef TsplPluginPackage?>
      <ComponentRef Id="TsplPluginPackageFile" />
      <?endif?>
      <Feature Id="AutoStartFeature" Level="1" Display="hidden">
        <Level Value="0" Condition="NOT AUTO_START" />
        <ComponentRef Id="AutoStartRunKey" />
      </Feature>
    </Feature>

    <!-- 覆盖安装前经旧版已有的 loopback API 请求宿主退出；拒绝响应（如正在打印）即中止安装。
         ExeCommand 的 Target 属 MSI Formatted 语义：空花括号对 {} 会被引擎剥除、[x] 序列按属性替换，
         故命令内 PowerShell 禁止空块（catch {} 等）与任何方括号形态——探测失败分支写作非空体 catch { $null }。
         verify-msi-ui.ps1 会以真实引擎 FormatRecord 转换后静态解析内层脚本防复发。 -->
    <CustomAction Id="ShutdownWinHost" Directory="SystemFolder" Execute="immediate" Return="check"
      ExeCommand="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$ErrorActionPreference='Stop'; $p=Get-CimInstance Win32_Process -Filter 'Name=''LabelFrame.WinHost.exe''' -ErrorAction Stop | Where-Object { $_.CommandLine -notmatch '(^|\s)--(update-service|restart-wait)(\s|$)' } | Select-Object -First 1; if (!$p) { exit 0 }; $pidToStop=$p.ProcessId; $ports=@(Get-NetTCPConnection -State Listen -OwningProcess $pidToStop -ErrorAction SilentlyContinue | Select-Object -ExpandProperty LocalPort -Unique); if (!$ports) { Write-Error 'LabelFrame 正在运行但无法定位本机 API 端口，已中止升级'; exit 1 }; $base=$null; foreach ($port in $ports) { try { $jobs=@(Invoke-RestMethod -TimeoutSec 3 -Uri ('http://127.0.0.1:'+$port+'/api/jobs?limit=500')); $base='http://127.0.0.1:'+$port; break } catch { $null } }; if (!$base) { Write-Error '无法读取 LabelFrame 作业状态，已中止升级'; exit 1 }; $busy=@($jobs | Where-Object { $_.status -eq 'Printing' -or @($_.items | Where-Object { $_.status -eq 'Printing' }).Count -gt 0 }); if ($busy.Count -gt 0) { Write-Error 'LabelFrame 当前有标签正在打印，请等待本张完成后重试升级'; exit 1 }; try { Invoke-WebRequest -UseBasicParsing -Method Post -TimeoutSec 2 -Uri ($base+'/api/host/shutdown') | Out-Null } catch { if ($_.Exception.Response -and $_.Exception.Response.StatusCode.value__ -eq 409) { Write-Error 'LabelFrame 当前有标签正在打印，请等待本张完成后重试升级'; exit 1 }; Write-Error '无法请求 LabelFrame 安全退出，已中止升级'; exit 1 }; $deadline=(Get-Date).AddSeconds(15); do { Start-Sleep -Milliseconds 250; $p=Get-Process -Id $pidToStop -ErrorAction SilentlyContinue } while ($p -and (Get-Date) -lt $deadline); if ($p) { Write-Error 'LabelFrame 未能在 15 秒内安全退出，已中止升级'; exit 1 }&quot;" />
    <!-- 完成页「立即打开」：Finish 按钮在勾选时触发（见 Publish），异步启动不阻塞向导关闭 -->
    <CustomAction Id="LaunchClientOnExit" Directory="INSTALLFOLDER" Execute="immediate" Return="asyncNoWait"
                  ExeCommand="&quot;[#WinHostExe]&quot;" />
    <!-- 卸载清理用户数据（勾选 CLEAR_USER_DATA 且为手动卸载时执行；升级不触发；新增机器级配置 settings.json）。
         host 日志按日轮转（host-yyyyMMdd.log），清理一并覆盖单名历史文件与轮转文件 -->
    <CustomAction Id="ClearDataDelFiles" Directory="SystemFolder" Execute="deferred" Impersonate="yes" Return="ignore"
      ExeCommand="cmd.exe /c del /q &quot;%LOCALAPPDATA%\LabelFrame\jobs.db&quot; &quot;%LOCALAPPDATA%\LabelFrame\templates.db&quot; &quot;%LOCALAPPDATA%\LabelFrame\logs.db&quot; &quot;%LOCALAPPDATA%\LabelFrame\host.log&quot; &quot;%LOCALAPPDATA%\LabelFrame\host-*.log&quot; &quot;%LOCALAPPDATA%\LabelFrame\connection.json&quot;" />
    <CustomAction Id="ClearDataDelPrintDir" Directory="SystemFolder" Execute="deferred" Impersonate="yes" Return="ignore"
      ExeCommand="cmd.exe /c rmdir /s /q &quot;%LOCALAPPDATA%\LabelFrame\print&quot;" />
    <CustomAction Id="ClearDataDelMachineConfig" Directory="SystemFolder" Execute="deferred" Impersonate="yes" Return="ignore"
      ExeCommand="cmd.exe /c del /q &quot;%ProgramData%\LabelFrame\Client\settings.json&quot;" />
    <CustomAction Id="ClearDataDelAppSettings" Directory="SystemFolder" Execute="deferred" Impersonate="yes" Return="ignore"
      ExeCommand="cmd.exe /c del /q &quot;%ProgramFiles%\LabelFrame\Client\appsettings.json&quot;" />
    <InstallExecuteSequence>
      <!-- CostFinalize 后、InstallValidate 前停止宿主，避免文件占用检查先弹出 Restart Manager 对话框。 -->
      <Custom Action="ShutdownWinHost" Before="InstallValidate" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="ClearDataDelFiles" After="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND CLEAR_USER_DATA=&quot;1&quot;" />
      <Custom Action="ClearDataDelPrintDir" After="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND CLEAR_USER_DATA=&quot;1&quot;" />
      <Custom Action="ClearDataDelMachineConfig" After="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND CLEAR_USER_DATA=&quot;1&quot;" />
      <Custom Action="ClearDataDelAppSettings" After="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND CLEAR_USER_DATA=&quot;1&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
