<?xml version="1.0" encoding="utf-8"?>
<!--
  LabelFrame 安装引导 Bundle（WiX Burn）。

  - BA = src/LabelFrame.Bootstrapper.Ba（net48 托管 BA，out-of-proc：五步问卷（只读）→ 确认页「安装」→ Plan + Apply）；
  - 链（七包，单一回滚边界）：
      1. DotNetDesktopRuntime（.NET 10 Desktop Runtime x64，厂商直链，Permanent，DetectCondition = BA 探测变量）
      2. DotNetAspNetCoreRuntime（ASP.NET Core Runtime x64，厂商直链，Permanent——Server 与 Client（WinHost）组件均 Sdk.Web 隐式
         FrameworkReference 所需，与 Desktop Runtime 互不包含；服务端与客户端预设安装）
      3. WebView2Runtime（evergreen 直链专用形态：载体 = PayloadTool 内嵌（-install-webview2），无远程载荷——
         下载 / 微软 Authenticode 发布者验签 / 静默安装全部内移至包执行期（引擎提权上下文），免疫微软轮换直链文件；
         -source 由 BA 写入的 WebView2Source 变量提供（布局本地文件优先 → 清单 urls → 工具内官方 fwlink 兜底））
      4. ServerMsi / 5. ClientMsi（既有，Compressed=no + DownloadUrl）
      6. WebUiPlacement / 8. ZebraPluginPlacement（非 MSI 落位：PayloadTool 内嵌（Compressed=yes）+ zip 子 Payload 远程下载，
         InstallArguments 以 [变量] 引用 BA 写入的落位目标目录并传 -version 写落位凭据；插件落位走工具内版本比较；
         Permanent 维持——Burn 约束（WIX0408）非 Permanent ExePackage 必须有 DetectCondition，而引擎级 Present 跳过会改写
         「webui 重跑覆盖重写 / 插件版本比较在工具内」既定语义，落位包安装路径零改动）
      7. WebUiPlacementCleanup / 9. ZebraPluginPlacementCleanup（成对清理包）：install = 无参空操作
         （登记包已装供 Burn 卸载规划），UninstallArguments -clean 清理落位目录——卸载 / Modify 改选 / 回滚时执行；
         DetectCondition = BA 启动期写入的落位凭据探测变量（凭据 = .labelframe-bundle-placement 文件）
  - 运行时条目消费 install manifest：.NET 双 runtime 的 DownloadUrl / sha256 由 scripts/build-bundle.ps1 按 manifest
    校验后传入本地产物（版本化直链，哈希钉死维持）；WebView2 evergreen 例外——不进引擎获取，构建期不下载；
  - 缓存策略：三个 runtime 包 Cache="remove"（Permanent 永不随 Bundle 卸载——执行才缓存、结束即清；
    WiX v4+ 计划语义 keep + Present 会尝试缓存 = 已装机器陪跑下载的机制根源，wixtoolset/issues#7021）——
    已装（Present）/ 未选的 runtime 包零获取。MSI 与落位包缓存策略不动（MSI 修复需驻留缓存；落位包每次安装会话都执行）。
  - 落位 / 清理包 CacheId 版本化：<包名>.<BundleVersion>——常量 CacheId 跨版本共享
    Package Cache 子目录 × PayloadTool.exe 每版本哈希必变 = 升级会话缓存校验必冲突（真机实测 0x80091007）。
  - 构建：scripts/build-bundle.ps1（wix build；需真实包文件提取元数据，故不进 LabelFrame.slnx）。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- 品牌 v02 EXE 图标 spike 结论：WiX v7 原生支持 Bundle@IconSourceFile——构建期把 ICO 以
       GroupIconResource("#1") 嵌入最终 Bundle EXE（wixtoolset/wix CreateBundleExeCommand.cs）；v5 的
       「窗体/任务栏图标不显示」回归（wixtoolset/issues#8104，ARP 正常）已定版 v7.0.0-rc.1 修复（PR wix#678），
       本仓 wix 7.0.0 在修复线内——无需构建后 Win32 资源替换，spike 未走降级路径。 -->
  <Bundle Name="LabelFrame 安装引导"
          Version="$(var.BundleVersion)"
          Manufacturer="LabelFrame"
          IconSourceFile="$(var.AssetsDir)labelframe.ico"
          UpgradeCode="6F14EEB0-8B38-4EBC-A9E1-368E338E3FE6">

    <!-- BA 载荷：EXE 为主文件，发布目录其余文件（含 mbanative.dll / API 程序集 / System.Text.Json 依赖）整体打包 -->
    <BootstrapperApplication SourceFile="$(var.BaDir)LabelFrame.Bootstrapper.Ba.exe">
      <Payloads Include="$(var.BaDir)**">
        <Exclude Files="$(var.BaDir)LabelFrame.Bootstrapper.Ba.exe" />
        <Exclude Files="$(var.BaDir)*.pdb" />
      </Payloads>
    </BootstrapperApplication>

    <!-- PayloadTool 伴生依赖（net48 framework-dependent 发布目录除 EXE 外全部文件；工具从包缓存目录加载） -->
    <PayloadGroup Id="PayloadToolDependencies">
      <Payload SourceFile="$(var.PayloadToolDir)LabelFrame.Bootstrapper.PayloadTool.exe.config" Compressed="yes" />
      <Payload SourceFile="$(var.PayloadToolDir)LabelFrame.Bootstrapper.dll" Compressed="yes" />
      <Payload SourceFile="$(var.PayloadToolDir)Microsoft.Bcl.AsyncInterfaces.dll" Compressed="yes" />
      <Payload SourceFile="$(var.PayloadToolDir)System.Buffers.dll" Compressed="yes" />
      <Payload SourceFile="$(var.PayloadToolDir)System.IO.Pipelines.dll" Compressed="yes" />
      <Payload SourceFile="$(var.PayloadToolDir)System.Memory.dll" Compressed="yes" />
      <Payload SourceFile="$(var.PayloadToolDir)System.Numerics.Vectors.dll" Compressed="yes" />
      <Payload SourceFile="$(var.PayloadToolDir)System.Runtime.CompilerServices.Unsafe.dll" Compressed="yes" />
      <Payload SourceFile="$(var.PayloadToolDir)System.Text.Encodings.Web.dll" Compressed="yes" />
      <Payload SourceFile="$(var.PayloadToolDir)System.Text.Json.dll" Compressed="yes" />
      <Payload SourceFile="$(var.PayloadToolDir)System.Threading.Tasks.Extensions.dll" Compressed="yes" />
    </PayloadGroup>

    <!-- 问卷变量契约：BA 按问卷解析结果写入，链内条件消费 -->
    <Variable Name="InstallPreset" Type="string" Value="" />
    <Variable Name="InstallServer" Type="numeric" Value="0" />
    <Variable Name="InstallClient" Type="numeric" Value="0" />
    <Variable Name="InstallWebUi" Type="numeric" Value="0" />
    <Variable Name="InstallPluginZebra" Type="numeric" Value="0" />
    <Variable Name="InstallPluginTspl" Type="numeric" Value="0" />
    <!-- 运行时探测变量：BA 于 Detect 前写入，runtime 包 DetectCondition 消费（真 = 已装跳过） -->
    <Variable Name="DesktopRuntimeInstalled" Type="numeric" Value="0" />
    <Variable Name="AspNetCoreRuntimeInstalled" Type="numeric" Value="0" />
    <Variable Name="WebView2Installed" Type="numeric" Value="0" />
    <!-- evergreen 源变量：BA 随确认页写入（布局目录本地文件在位优先，否则清单 urls 顺序拼接，
         空 = 非交互 / 清单缺条目——工具按官方 fwlink 兜底）；WebView2Runtime 包 InstallArguments 以 [变量] 引用 -->
    <Variable Name="WebView2Source" Type="string" Value="" />
    <!-- 落位目标变量：BA 启动期写入绝对路径（交互 / 非交互路径全覆盖——ARP 卸载会话的
         UninstallArguments [变量] 引用同样可解析），落位包 InstallArguments 以 [变量] 引用 -->
    <Variable Name="WebUiTargetDir" Type="string" Value="" />
    <Variable Name="PluginZebraTargetDir" Type="string" Value="" />
    <Variable Name="PluginTsplTargetDir" Type="string" Value="" />
    <!-- 落位凭据探测变量：BA 启动期读落位目录凭据文件（.labelframe-bundle-placement）比对
         WixBundleVersion 写入——清理包 DetectCondition 消费（真 = 本版本 Bundle 落位在位 → Present） -->
    <Variable Name="WebUiPlacementPresent" Type="numeric" Value="0" />
    <Variable Name="ZebraPluginPlacementPresent" Type="numeric" Value="0" />
    <Variable Name="TsplPluginPlacementPresent" Type="numeric" Value="0" />

    <Chain>
      <!-- 1) .NET 10 Desktop Runtime x64：缺失才装、已装跳过；共享系统组件不随 bundle 卸载。
           Cache=remove：Permanent 永不卸载 → 执行才缓存、结束即清——已装（Present）机器不再陪跑下载校验 -->
      <ExePackage Id="DotNetDesktopRuntime"
                  SourceFile="$(var.RuntimeDesktopPath)"
                  Name="windowsdesktop-runtime-$(var.RuntimeDesktopVersion)-win-x64.exe"
                  Compressed="no"
                  DownloadUrl="$(var.RuntimeDesktopUrl)"
                  Permanent="yes"
                  PerMachine="yes"
                  Cache="remove"
                  DetectCondition="DesktopRuntimeInstalled"
                  InstallCondition="InstallServer OR InstallClient"
                  InstallArguments="/install /quiet /norestart">
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>

      <!-- 2) ASP.NET Core Runtime x64：Server 与 Client（WinHost）
           组件均 Sdk.Web 隐式 FrameworkReference 所需，与 Desktop Runtime 互不包含；服务端与客户端预设安装（对齐
           DotNetDesktopRuntime 双预设条件），缺失才装、已装跳过；共享系统组件不随 bundle 卸载；
           Cache=remove 同 1 -->
      <ExePackage Id="DotNetAspNetCoreRuntime"
                  SourceFile="$(var.RuntimeAspNetCorePath)"
                  Name="aspnetcore-runtime-$(var.RuntimeAspNetCoreVersion)-win-x64.exe"
                  Compressed="no"
                  DownloadUrl="$(var.RuntimeAspNetCoreUrl)"
                  Permanent="yes"
                  PerMachine="yes"
                  Cache="remove"
                  DetectCondition="AspNetCoreRuntimeInstalled"
                  InstallCondition="InstallServer OR InstallClient"
                  InstallArguments="/install /quiet /norestart">
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>

      <!-- 3) WebView2 Evergreen 引导器：载体 = PayloadTool 内嵌（Compressed=yes），evergreen 安装器不作
           远程载荷（无构建期摘要可钉——恒变 fwlink 直钉哈希 = 每次微软轮换全体装机失败）。下载 / 微软 Authenticode 发布者
           验签 / 静默安装由工具在包执行期完成（引擎提权上下文，链位仍居 ClientMsi 前满足其 LaunchCondition）；
           DetectCondition 已装 → Present → 计划跳过 = 零获取零执行。退出码：工具验签拒绝 40 / 全源失败 41（链失败，
           失败报告呈现）；安装器退出码透传（3010 映射 scheduleReboot） -->
      <ExePackage Id="WebView2Runtime"
                  CacheId="WebView2Runtime"
                  SourceFile="$(var.PayloadToolPath)"
                  Name="LabelFrame.PayloadTool.exe"
                  Compressed="yes"
                  Permanent="yes"
                  PerMachine="yes"
                  Cache="remove"
                  DetectCondition="WebView2Installed"
                  InstallCondition="InstallClient"
                  InstallArguments="-install-webview2 -source &quot;[WebView2Source]&quot;">
        <PayloadGroupRef Id="PayloadToolDependencies" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>

      <!-- 4) Server MSI（既有） -->
      <MsiPackage Id="ServerMsi"
                  SourceFile="$(var.MsiDir)LabelFrame-Server-$(var.ProductVersion).msi"
                  Compressed="no"
                  InstallCondition="InstallServer"
                  DownloadUrl="$(var.DownloadBase)/LabelFrame-Server-$(var.ProductVersion).msi" />

      <!-- 5) Client MSI（既有） -->
      <MsiPackage Id="ClientMsi"
                  SourceFile="$(var.MsiDir)LabelFrame-Client-$(var.ProductVersion).msi"
                  Compressed="no"
                  InstallCondition="InstallClient"
                  DownloadUrl="$(var.DownloadBase)/LabelFrame-Client-$(var.ProductVersion).msi" />

      <!-- 6) 管理界面 zip 落位：PayloadTool 内嵌（Compressed=yes）+ zip 子 Payload 远程下载；目标目录变量由 BA 写入；
           -version 传 Bundle 版本供落位凭据写入。Permanent 维持（安装路径零改动）。
           CacheId 版本化：PayloadTool.exe 每版本哈希必变，常量 CacheId 跨版本共享包缓存目录
           → 升级会话缓存校验必冲突（0x80091007 删缓存转重取）；版本化后每版本独立缓存目录，升级零冲突 -->
      <ExePackage Id="WebUiPlacement"
                  CacheId="WebUiPlacement.$(var.BundleVersion)"
                  SourceFile="$(var.PayloadToolPath)"
                  Name="LabelFrame.PayloadTool.exe"
                  Compressed="yes"
                  Permanent="yes"
                  PerMachine="yes"
                  InstallCondition="InstallWebUi"
                  InstallArguments="-place -archive labelframe-server-webui-$(var.ProductVersion).zip -version $(var.ProductVersion) -target &quot;[WebUiTargetDir]&quot;">
        <PayloadGroupRef Id="PayloadToolDependencies" />
        <Payload SourceFile="$(var.WebUiZipPath)"
                 Name="labelframe-server-webui-$(var.ProductVersion).zip"
                 Compressed="no"
                 DownloadUrl="$(var.DownloadBase)/labelframe-server-webui-$(var.ProductVersion).zip" />
      </ExePackage>

      <!-- 7) webui 成对清理包：install = 无参空操作（登记包已装）；卸载 / Modify 改选（InstallCondition
           假）/ 失败回滚时 Burn 执行 UninstallArguments -clean 清理落位目录；DetectCondition = 凭据探测变量（BA 启动期写入）；
           CacheId 版本化同 6 -->
      <ExePackage Id="WebUiPlacementCleanup"
                  CacheId="WebUiPlacementCleanup.$(var.BundleVersion)"
                  SourceFile="$(var.PayloadToolPath)"
                  Name="LabelFrame.PayloadTool.exe"
                  Compressed="yes"
                  PerMachine="yes"
                  DetectCondition="WebUiPlacementPresent"
                  InstallCondition="InstallWebUi"
                  UninstallArguments="-clean -target &quot;[WebUiTargetDir]&quot;">
        <PayloadGroupRef Id="PayloadToolDependencies" />
      </ExePackage>

      <!-- 8) Zebra 官方插件 .lfplugin 落位（版本比较：新版本覆盖 / 同版本幂等 / 降级拒绝）；-version 写凭据；Permanent 维持。
           机制通用：后续品牌落位包按本行 + 成对清理包同构扩展；CacheId 版本化同 6 -->
      <ExePackage Id="ZebraPluginPlacement"
                  CacheId="ZebraPluginPlacement.$(var.BundleVersion)"
                  SourceFile="$(var.PayloadToolPath)"
                  Name="LabelFrame.PayloadTool.exe"
                  Compressed="yes"
                  Permanent="yes"
                  PerMachine="yes"
                  InstallCondition="InstallPluginZebra"
                  InstallArguments="-plugin -archive labelframe-transport-zebra-$(var.ProductVersion).lfplugin -version $(var.ProductVersion) -target &quot;[PluginZebraTargetDir]&quot;">
        <PayloadGroupRef Id="PayloadToolDependencies" />
        <Payload SourceFile="$(var.ZebraPluginPath)"
                 Name="labelframe-transport-zebra-$(var.ProductVersion).lfplugin"
                 Compressed="no"
                 DownloadUrl="$(var.DownloadBase)/labelframe-transport-zebra-$(var.ProductVersion).lfplugin" />
      </ExePackage>

      <!-- 9) zebra 成对清理包（同 7；CacheId 版本化同 6） -->
      <ExePackage Id="ZebraPluginPlacementCleanup"
                  CacheId="ZebraPluginPlacementCleanup.$(var.BundleVersion)"
                  SourceFile="$(var.PayloadToolPath)"
                  Name="LabelFrame.PayloadTool.exe"
                  Compressed="yes"
                  PerMachine="yes"
                  DetectCondition="ZebraPluginPlacementPresent"
                  InstallCondition="InstallPluginZebra"
                  UninstallArguments="-clean -target &quot;[PluginZebraTargetDir]&quot;">
        <PayloadGroupRef Id="PayloadToolDependencies" />
      </ExePackage>

      <!-- 10) TSPL 官方插件 .lfplugin 落位（指令集维度，决策 #195；机制同 8） -->
      <ExePackage Id="TsplPluginPlacement"
                  CacheId="TsplPluginPlacement.$(var.BundleVersion)"
                  SourceFile="$(var.PayloadToolPath)"
                  Name="LabelFrame.PayloadTool.exe"
                  Compressed="yes"
                  Permanent="yes"
                  PerMachine="yes"
                  InstallCondition="InstallPluginTspl"
                  InstallArguments="-plugin -archive labelframe-transport-tspl-$(var.ProductVersion).lfplugin -version $(var.ProductVersion) -target &quot;[PluginTsplTargetDir]&quot;">
        <PayloadGroupRef Id="PayloadToolDependencies" />
        <Payload SourceFile="$(var.TsplPluginPath)"
                 Name="labelframe-transport-tspl-$(var.ProductVersion).lfplugin"
                 Compressed="no"
                 DownloadUrl="$(var.DownloadBase)/labelframe-transport-tspl-$(var.ProductVersion).lfplugin" />
      </ExePackage>

      <!-- 11) tspl 成对清理包（同 9） -->
      <ExePackage Id="TsplPluginPlacementCleanup"
                  CacheId="TsplPluginPlacementCleanup.$(var.BundleVersion)"
                  SourceFile="$(var.PayloadToolPath)"
                  Name="LabelFrame.PayloadTool.exe"
                  Compressed="yes"
                  PerMachine="yes"
                  DetectCondition="TsplPluginPlacementPresent"
                  InstallCondition="InstallPluginTspl"
                  UninstallArguments="-clean -target &quot;[PluginTsplTargetDir]&quot;">
        <PayloadGroupRef Id="PayloadToolDependencies" />
      </ExePackage>
    </Chain>
  </Bundle>
</Wix>
