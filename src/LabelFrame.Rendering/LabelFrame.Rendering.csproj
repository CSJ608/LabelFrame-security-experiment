<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LabelFrame.Rendering</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- SkiaSharp 版本下限为兼容义务：低于 3.119.2 会在 Client MSI 覆盖升级链
         触发 Windows Installer 组件规则拒装降版 keyfile；升版时须同步上调
         scripts/assert-client-deps-baseline.ps1 基线。 -->
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <!-- Linux 服务端需要 Skia 原生库；Windows 由主包提供 -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabelFrame.Core\LabelFrame.Core.csproj" />
  </ItemGroup>

</Project>