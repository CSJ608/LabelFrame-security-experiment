<Project Sdk="Microsoft.NET.Sdk">

  <!-- Zebra 品牌传输官方插件工程：外置 .lfplugin 包（scripts/build-zebra-plugin.ps1 构建），SDK 依赖随包分发。
       目标框架须与 WinHost windows 腿一致——插件 DLL 由宿主运行时字节加载，TFM 越前即破坏装配。 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100</TargetFramework>
    <RootNamespace>LabelFrame.TransportPlugin.Zebra</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Zebra 官方 Link-OS SDK：USB / TCP / 驱动 / 蓝牙统一连接与打印机状态；版本须与 AndroidHost 内置统一（双端复用）。 -->
    <PackageReference Include="Zebra.Printer.SDK" Version="5.0.3685" />
    <!-- 毒丸引用清单（Windows 验证版，全部 ExcludeAssets="all"）：
         Zebra SDK 5.x 传递依赖 SkiaSharp.Views.Maui.Controls，其 MAUI / WinUI 程序集链会——
         ① 混入编译（Microsoft.Maui.Controls.Label 等 MAUI 类型与宿主 WinForms / WebView2 投影类型冲突）；
         ② WindowsAppSDK 的 buildTransitive 注入 win10-* RID 图（win-x64 framework-dependent 工程不识别，NETSDK1083）。
         ExcludeAssets="all" 不裁剪传递闭包，故须逐包显式排除整条 MAUI / WinUI 链。
         保留 SkiaSharp + SkiaSharp.NativeAssets.Win32（SDK 图形工具引用；宿主经 LabelFrame.Rendering 已随附）。 -->
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.2" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.Views" Version="3.119.2" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.Views.Maui.Core" Version="3.119.2" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.Views.WinUI" Version="3.119.2" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.WinUI" Version="3.119.2" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Controls.Core" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Controls.Xaml" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Core" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Graphics.Win2D.WinUI.Desktop" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Resizetizer" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Maui.Controls.Build.Tasks" Version="8.0.82" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.2.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240627000" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabelFrame.Core\LabelFrame.Core.csproj" />
  </ItemGroup>

</Project>
