<Project Sdk="Microsoft.NET.Sdk">

  <!-- WiX Burn 托管 BA（out-of-proc 模型）：独立 EXE 进程，经 WixToolset.BootstrapperApplicationApi 与 Burn 引擎握手。
       net48 不可升——.NET Framework 4.8 是 Win10 1809+ / Win11 的 OS 组件，裸机免装运行时（首个 EXE 不得依赖新版 .NET）。
       RuntimeIdentifier 使 mbanative.dll（包内 runtimes 资产）复制到输出，随 Bundle 打包为 BA 载荷。 -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>LabelFrame.Bootstrapper.Ba</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\labelframe.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- WiX v7 OSMF EULA 接受（WIX7015，MSBuild 集成消费点要求）；费用阈值评估见 https://wixtoolset.org/osmf/ -->
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="7.0.0" />
  </ItemGroup>

  <!-- 核心库公共 API 暴露 HttpClient（LoadManifestAsync 注入口），net48 需显式引用；完成页服务状态查询用 ServiceController -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabelFrame.Bootstrapper\LabelFrame.Bootstrapper.csproj" />
  </ItemGroup>

  <!-- 向导头部 lockup 以嵌入资源随 BA EXE 携带（LogicalName 钉死清单名，不依赖安装期外部文件路径；
       资源缺失时 UI 侧降级为无品牌条，不阻断安装） -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\brand\bootstrapper-lockup.png" LogicalName="bootstrapper-lockup.png" />
  </ItemGroup>

</Project>
